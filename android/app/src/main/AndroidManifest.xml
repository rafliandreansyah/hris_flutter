<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Lokasi untuk GPS Presensi & Aktivitas Lapangan -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Sengaja TIDAK meminta ACCESS_BACKGROUND_LOCATION: pelacakan berjalan lewat foreground
         service (notifikasi persisten) yang dimulai saat clock-in di foreground. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Kamera untuk Selfie Absensi, Foto Profil & Bukti Lapangan -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Kamera hanya untuk foto (enableAudio: false); buang RECORD_AUDIO bawaan plugin camera -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove" />

    <!-- Biometrik (Sidik Jari & Pengenalan Wajah) untuk Presensi -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Notifikasi Push & Pengingat Shift/Aktivitas -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Pengingat "lanjutkan pelacakan" setelah HP dinyalakan ulang -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Akses Galeri & Dokumen (Slip Gaji, Klaim Reimburse, Surat Sakit) -->
    <!-- Android 13+ memakai Photo Picker (image_picker) sehingga READ_MEDIA_* tidak diperlukan
         (kebijakan Photo & Video Permissions Google Play). -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" tools:node="remove" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" tools:node="remove" />
    <!-- Android 12 ke bawah (API <= 32) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"
        tools:replace="android:maxSdkVersion" />

    <!-- Jaringan & Internet -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:label="Oasish"
        android:name="${applicationName}"
        android:largeHeap="true"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <intent-filter>
                <action android:name="FLUTTER_NOTIFICATION_CLICK"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
            <!-- App Links: filter host ada di src/debug|profile (dev) dan src/release (prod, tenant, klien custom).
                 Dipisah per build type karena Android <=11 menganggap paket terverifikasi hanya bila SEMUA host lolos. -->
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Google Maps API Key: Masukkan API Key Google Cloud Console Anda di sini -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyAxluVQ5yX2bwyqDMxXRP066Q5xgxk83vQ"/>

        <!-- Foreground Service Geolocator untuk Pelacakan Lokasi Latar Belakang -->
        <service
            android:name="com.baseflow.geolocator.GeolocatorLocationService"
            android:foregroundServiceType="location"
            android:exported="false" />

        <!-- Setelah reboot / update app: tampilkan notifikasi untuk melanjutkan pelacakan aktif -->
        <receiver
            android:name=".TrackingBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
