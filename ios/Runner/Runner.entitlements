<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Universal Links: link share pengajuan dari hris-web (host = ApiEndpoints.webBaseUrl). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:app.hroasish.com</string>
		<string>applinks:dev.hroasish.com</string>
	</array>
</dict>
</plist>
